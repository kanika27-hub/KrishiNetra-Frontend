function handleImage(event){
    const file = event.target.files[0];
    if(!file) return;
    processImage(file);
}

function processImage(file){
    if(!file.type.startsWith("image/")){
        showToast("Please choose a valid JPG/PNG crop image.");
        return;
    }

    selectedImage = file;
    const reader = new FileReader();

    reader.onload = function(e){
        const preview = document.getElementById("preview");
        const image = document.getElementById("previewImage");
        const button = document.getElementById("detectButton");

        image.src = e.target.result;
        preview.style.display = "block";

        // Hide camera if active
        stopCamera();

        button.disabled = false;
        button.classList.add("ready");
        showToast("Crop image loaded. Ready to analyze!");
    };

    reader.readAsDataURL(file);
}

/* ================= LIVE WEBCAM SCANNER ================= */
async function toggleCamera(){
    const cameraBox = document.getElementById("cameraBox");
    const preview = document.getElementById("preview");
    const video = document.getElementById("cameraVideo");

    if (cameraStream) {
        stopCamera();
        showToast("Camera scanner closed");
    } else {
        try {
            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: "environment" }
            });
            video.srcObject = cameraStream;
            video.play();
            cameraBox.style.display = "block";
            preview.style.display = "none";
            document.getElementById("cameraToggleBtn").textContent = "✕ Close Camera";
            showToast("Connected to live device camera");
        } catch (err) {
            console.warn("Camera access error:", err);
            showToast("Camera access unavailable. Using file upload mode.");
        }
    }
}

function stopCamera(){
    if (cameraStream) {
        cameraStream.getTracks().forEach(t => t.stop());
        cameraStream = null;
    }
    const cameraBox = document.getElementById("cameraBox");
    if (cameraBox) cameraBox.style.display = "none";
    const btn = document.getElementById("cameraToggleBtn");
    if (btn) btn.textContent = "📹 Live Camera Scanner";
}

