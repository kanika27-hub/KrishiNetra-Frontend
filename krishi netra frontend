                    </label>
                    <button type="button" class="secondary" id="cameraToggleBtn" onclick="toggleCamera()">
                        📹 Live Camera Scanner
                    </button>
                </div>

                <input
                    type="file"
                    id="imageInput"
                    class="file-input"
                    accept="image/*"
                    onchange="handleImage(event)"
                >

                <!-- Live Camera Viewfinder -->
                <div class="camera-box" id="cameraBox">
                    <video id="cameraVideo" playsinline autoplay muted></video>
                    <div class="camera-hud">
                        <div class="camera-crosshair"></div>
                    </div>
                    <div style="position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:10px;z-index:10;">
