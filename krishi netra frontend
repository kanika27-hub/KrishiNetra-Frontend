/* ================= CSV EXPORT ================= */
function exportHistoryCSV(){
    const rows = document.querySelectorAll("#historyTable tbody tr");
    let csv = "Pest,Crop Location,Confidence,Severity,Detection Time,Status\n";

    rows.forEach(r => {
        const cols = r.querySelectorAll("td");
        if(cols.length >= 6){
            const pest = cols[0].innerText.replace(/"/g, '""');
            const crop = cols[1].innerText.replace(/"/g, '""');
            const conf = cols[2].innerText.replace(/"/g, '""');
            const sev = cols[3].innerText.replace(/"/g, '""');
            const time = cols[4].innerText.replace(/"/g, '""');
            const status = cols[5].innerText.replace(/"/g, '""');
            csv += `"${pest}","${crop}","${conf}","${sev}","${time}","${status}"\n`;
        }
    });

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `krishi_netra_scout_report_${Date.now()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showToast("CSV Scouting Report exported!");
}

/* ================= HISTORY FILTER ================= */
function filterHistory(){
    const search = document.getElementById("historySearch").value.toLowerCase();
    const severity = document.getElementById("severityFilter").value;
    const rows = document.querySelectorAll("#historyTable tbody tr");

    rows.forEach(row=>{
        const text = row.textContent.toLowerCase();
        const rowSeverity = row.getAttribute("data-severity");
        const matchesSearch = text.includes(search);
        const matchesSeverity = severity === "all" || rowSeverity === severity;
        row.style.display = matchesSearch && matchesSeverity ? "" : "none";
    });
}

