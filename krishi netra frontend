<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KRISHI NETRA | Intelligent Pest Detection</title>

<style>
:root{
    --green:#16834b;
    --green-dark:#0d6037;
    --green-light:#e9f8ef;
    --lime:#9bd45c;
    --orange:#f59e0b;
    --red:#ef4444;
    --blue:#3b82f6;
    --dark:#17231d;
    --text:#26332b;
    --muted:#718078;
    --bg:#f4f8f5;
    --white:#ffffff;
    --border:#e1e9e4;
    --shadow:0 10px 30px rgba(23,55,37,.08);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Inter,Segoe UI,Arial,sans-serif;
}

body{
    background:var(--bg);
    color:var(--text);
}

button,input,select{
    font:inherit;
}

button{
    cursor:pointer;
    border:0;
}

.app{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */
.sidebar{
    width:260px;
    background:#10291c;
    color:white;
    padding:25px 17px;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    z-index:50;
    overflow-y:auto;
}

.logo{
    display:flex;
    align-items:center;
    gap:11px;
    padding:8px 12px 25px;
}

.logo-icon{
    width:43px;
    height:43px;
    border-radius:14px;
    background:linear-gradient(135deg,#9bd45c,#16834b);
    display:grid;
    place-items:center;
    font-size:24px;
}

.logo h1{
    font-size:20px;
    letter-spacing:.5px;
}

.logo span{
    display:block;
    color:#a8c7b3;
    font-size:10px;
    margin-top:3px;
}

.nav-title{
    color:#73917e;
    font-size:10px;
    font-weight:700;
    padding:10px 13px;
    letter-spacing:1px;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.nav button{
    color:#bdd0c4;
    background:transparent;
    padding:13px 14px;
    border-radius:12px;
    text-align:left;
    display:flex;
    gap:12px;
    align-items:center;
    transition:.2s;
    font-size:13px;
}

.nav button:hover,
.nav button.active{
    background:#1b4930;
    color:white;
}

.nav-icon{
    width:23px;
    text-align:center;
}

.nav-badge{
    margin-left:auto;
    background:rgba(239,68,68,0.25);
    color:#fca5a5;
    padding:2px 7px;
    border-radius:10px;
    font-size:10px;
    font-weight:700;
}

.sidebar-bottom{
    margin-top:25px;
    padding-bottom:10px;
}

.help-card{
    background:#173a27;
    padding:15px;
    border-radius:15px;
    font-size:12px;
    color:#c7d9cd;
}

.help-card strong{
    display:block;
    color:white;
    margin-bottom:5px;
}

/* MAIN */
.main{
    margin-left:260px;
    width:calc(100% - 260px);
}

.topbar{
    height:76px;
    background:white;
    border-bottom:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:0 32px;
    position:sticky;
    top:0;
    z-index:30;
}

.page-title h2{
    font-size:21px;
}

.page-title p{
    color:var(--muted);
    font-size:12px;
    margin-top:4px;
}

.top-actions{
    display:flex;
    align-items:center;
    gap:15px;
}

.weather-badge{
    display:flex;
    align-items:center;
    gap:8px;
    background:var(--bg);
    border:1px solid var(--border);
    padding:6px 14px;
    border-radius:30px;
    font-size:12px;
    font-weight:600;
}

.weather-badge .live-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#22c55e;
    animation:pulseDot 2s infinite;
}

@keyframes pulseDot{
    0%{ transform:scale(0.9); opacity:0.8; }
    50%{ transform:scale(1.3); opacity:1; }
    100%{ transform:scale(0.9); opacity:0.8; }
}

.icon-btn{
    width:39px;
    height:39px;
    border-radius:11px;
    background:#f2f6f3;
    position:relative;
    display:grid;
    place-items:center;
}

.notification-dot{
    position:absolute;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--red);
    right:8px;
    top:7px;
    border:2px solid white;
}

.profile{
    display:flex;
    align-items:center;
    gap:10px;
    cursor:pointer;
}

.avatar{
    width:39px;
    height:39px;
    background:#d9f1df;
    border-radius:50%;
    display:grid;
    place-items:center;
    font-weight:700;
    color:var(--green-dark);
}

/* REAL-TIME ADVISORY STRIP */
.realtime-advisory{
    background:linear-gradient(90deg, #eaf7ee 0%, #f4fbf6 100%);
    border-bottom:1px solid #d3ebd8;
    padding:10px 32px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:12px;
    color:#125230;
    font-weight:600;
}

.realtime-advisory span.pulse-tag{
    background:#22c55e;
    color:white;
    font-size:9px;
    font-weight:800;
    padding:2px 6px;
    border-radius:4px;
    letter-spacing:.5px;
    margin-right:8px;
}

.content{
    padding:28px 32px 45px;
    max-width:1500px;
}

/* COMMON */
.section{
    display:none;
}

.section.active{
    display:block;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.section-heading h2{
    font-size:22px;
}

.section-heading p{
    color:var(--muted);
    font-size:13px;
    margin-top:4px;
}

.primary{
    background:var(--green);
    color:white;
    padding:11px 17px;
    border-radius:10px;
    font-weight:700;
    transition:.2s;
    display:inline-flex;
    align-items:center;
    gap:6px;
}

.primary:hover{
    background:var(--green-dark);
    transform:translateY(-1px);
}

.secondary{
    background:white;
    color:var(--green-dark);
    border:1px solid var(--border);
    padding:10px 15px;
    border-radius:10px;
    font-weight:600;
    transition:.2s;
}

.secondary:hover{
    background:#f5fbf7;
    border-color:var(--green);
}

.grid{
    display:grid;
    gap:18px;
}

.stats{
    grid-template-columns:repeat(3,1fr);
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:18px;
    padding:20px;
    box-shadow:var(--shadow);
}

.stat{
    position:relative;
    overflow:hidden;
}

.stat-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.stat-icon{
    width:43px;
    height:43px;
    display:grid;
    place-items:center;
    border-radius:13px;
    background:var(--green-light);
    font-size:20px;
}

.stat-number{
    font-size:31px;
    font-weight:800;
    margin:17px 0 3px;
}

.stat-label{
    color:var(--muted);
    font-size:13px;
}

.change{
    margin-top:12px;
    font-size:11px;
    color:var(--green);
    font-weight:700;
}

/* DASHBOARD */
.dashboard-main{
    grid-template-columns:1.6fr 1fr;
    margin-top:18px;
}

.latest{
    min-height:300px;
}

.latest-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.latest-body{
    display:grid;
    grid-template-columns:170px 1fr;
    gap:22px;
}

.pest-image{
    height:170px;
    border-radius:16px;
    background:linear-gradient(135deg,#d8f0dd,#b7dfbd);
    display:grid;
    place-items:center;
    font-size:74px;
    overflow:hidden;
    position:relative;
}

.pest-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.pest-title{
    font-size:25px;
    font-weight:800;
}

.badges{
    display:flex;
    gap:8px;
    margin:9px 0 14px;
    flex-wrap:wrap;
}

.badge{
    padding:6px 10px;
    border-radius:30px;
    font-size:11px;
    font-weight:700;
}

.badge.green{ background:#e4f7ea; color:#177342; }
.badge.orange{ background:#fff4dc; color:#9a6200; }
.badge.red{ background:#ffe8e8; color:#b42323; }

.recommend{
    background:#f1faf4;
    border-left:4px solid var(--green);
    padding:13px;
    border-radius:10px;
    margin-top:14px;
}

.recommend strong{
    display:block;
    margin-bottom:4px;
    color:var(--green-dark);
}

.alert-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.alert{
    padding:13px;
    background:#f8faf9;
    border-radius:12px;
    display:flex;
    gap:10px;
    align-items:flex-start;
    border:1px solid var(--border);
    transition:.2s;
}

.alert:hover{
    border-color:var(--green);
    background:#ffffff;
}

.alert-icon{
    font-size:20px;
}

.alert strong{
    display:block;
    font-size:13px;
}

.alert small{
    color:var(--muted);
    font-size:11px;
}

.analytics-grid{
    grid-template-columns:1.3fr 1fr;
    margin-top:18px;
}

.chart{
    height:230px;
    display:flex;
    align-items:flex-end;
    gap:13px;
    padding:20px 10px 5px;
}

.bar-wrap{
    flex:1;
    height:100%;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    position:relative;
}

.bar{
    width:65%;
    max-width:38px;
    background:linear-gradient(to top,#16834b,#8bcf61);
    border-radius:7px 7px 2px 2px;
    transition:.4s;
}

.bar:hover{
    opacity:.75;
}

.bar-label{
    position:absolute;
    bottom:-22px;
    font-size:10px;
    color:var(--muted);
}

.bar-value{
    position:absolute;
    font-size:10px;
    top:-17px;
    color:var(--text);
    font-weight:700;
}

.progress-row{
    margin:17px 0;
}

.progress-head{
    display:flex;
    justify-content:space-between;
    font-size:12px;
    margin-bottom:7px;
}

.progress{
    height:8px;
    background:#edf2ee;
    border-radius:20px;
    overflow:hidden;
}

.progress span{
    display:block;
    height:100%;
    background:var(--green);
    border-radius:20px;
}

/* DETECTION STUDIO & MULTI-CROP SELECTOR */
.crop-pill-bar{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding-bottom:12px;
    margin-bottom:18px;
}

.crop-pill{
    padding:8px 14px;
    background:white;
    border:1px solid var(--border);
    border-radius:25px;
    font-size:12px;
    font-weight:600;
    color:var(--text);
    white-space:nowrap;
    display:flex;
    align-items:center;
    gap:6px;
    transition:.2s;
}

.crop-pill:hover,
.crop-pill.active{
    background:var(--green-light);
    border-color:var(--green);
    color:var(--green-dark);
    font-weight:700;
}

.detect-layout{
    grid-template-columns:1.2fr .8fr;
}

.upload-box{
    border:2px dashed #b9d4c1;
    border-radius:18px;
    padding:30px 20px;
    text-align:center;
    background:#fbfefc;
    transition:.2s;
    position:relative;
}

.upload-box.dragover{
    background:#effaf2;
    border-color:var(--green);
}

.upload-icon{
    width:58px;
    height:58px;
    margin:auto;
    background:var(--green-light);
    border-radius:18px;
    display:grid;
    place-items:center;
    font-size:26px;
}

.upload-box h3{
    margin:14px 0 6px;
}

.upload-box p{
    color:var(--muted);
    font-size:12px;
    line-height:1.6;
}

.file-input{
    display:none;
}

.upload-btn{
    display:inline-block;
    background:var(--green);
    color:white;
    padding:10px 18px;
    border-radius:10px;
    font-weight:700;
    font-size:12px;
}

.preview{
    margin-top:16px;
    display:none;
    position:relative;
}

.preview img{
    max-width:100%;
    max-height:260px;
    border-radius:14px;
    object-fit:cover;
}

/* REAL CAMERA FEED */
.camera-box{
    margin-top:16px;
    display:none;
    position:relative;
    border-radius:14px;
    overflow:hidden;
    background:#000;
}

.camera-box video{
    width:100%;
    max-height:300px;
    object-fit:cover;
    display:block;
}

.camera-hud{
    position:absolute;
    inset:0;
    pointer-events:none;
    display:flex;
    align-items:center;
    justify-content:center;
}

.camera-crosshair{
    width:180px;
    height:180px;
    border:2px dashed #4ade80;
    border-radius:12px;
}

.detect-btn{
    width:100%;
    margin-top:16px;
    padding:14px;
    border-radius:11px;
    background:#b7cdbd;
    color:white;
    font-weight:800;
    transition:.2s;
}

.detect-btn.ready{
    background:var(--green);
}

.detect-btn.ready:hover{
    background:var(--green-dark);
}

.result-card{
    min-height:100%;
}

.result-empty{
    text-align:center;
    padding:70px 20px;
    color:var(--muted);
}

.result-empty .big{
    font-size:50px;
    margin-bottom:10px;
}

.result{
    display:none;
}

.result.visible{
    display:block;
}

.result-pest{
    display:flex;
    gap:14px;
    align-items:center;
    margin-bottom:18px;
}

.result-pest-icon{
    width:64px;
    height:64px;
    border-radius:16px;
    background:#fff4dc;
    display:grid;
    place-items:center;
    font-size:31px;
    overflow:hidden;
}

.result-pest-icon img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.result-pest h3{
    font-size:22px;
}

.confidence{
    font-size:12px;
    color:var(--muted);
    margin-top:4px;
}

.info-list{
    display:grid;
    gap:10px;
    margin:18px 0;
}

.info-row{
    display:flex;
    justify-content:space-between;
    padding:10px 0;
    border-bottom:1px solid #edf1ee;
    font-size:12px;
}

.info-row span:last-child{
    font-weight:700;
}

.result-description{
    background:#f5f9f6;
    padding:14px;
    border-radius:12px;
    font-size:12px;
    line-height:1.7;
}

/* ALL CROP SAMPLE CARDS ROW */
.sample-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
    gap:10px;
    margin-top:14px;
    text-align:left;
}

.sample-item{
    background:white;
    border:1px solid var(--border);
    border-radius:10px;
    padding:8px 10px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:8px;
    font-size:11px;
    font-weight:600;
    transition:.2s;
}

.sample-item:hover{
    border-color:var(--green);
    background:var(--green-light);
    color:var(--green-dark);
}

.sample-item .ico{
    font-size:16px;
}

/* HISTORY */
.toolbar{
    display:flex;
    gap:10px;
    margin-bottom:17px;
}

.search{
    flex:1;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:11px;
    outline:none;
    background:white;
}

.search:focus{
    border-color:var(--green);
}

select{
    padding:12px;
    border:1px solid var(--border);
    border-radius:11px;
    background:white;
    outline:none;
}

.table-card{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

th{
    color:var(--muted);
    font-size:11px;
    text-align:left;
    padding:13px;
    border-bottom:1px solid var(--border);
}

td{
    padding:15px 13px;
    font-size:12px;
    border-bottom:1px solid #eef2ef;
}

.pest-cell{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:700;
}

/* ALERTS */
.alert-card{
    display:flex;
    justify-content:space-between;
    gap:20px;
    align-items:center;
}

.alert-left{
    display:flex;
    gap:14px;
    align-items:flex-start;
}

.alert-large{
    width:45px;
    height:45px;
    border-radius:13px;
    display:grid;
    place-items:center;
    background:#fff1df;
    font-size:20px;
}

.alert-content h3{
    font-size:15px;
    margin-bottom:5px;
}

.alert-content p{
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
}

.alert-time{
    font-size:10px;
    color:#9aa69f;
}

/* FREQUENCY */
.frequency-card{
    background:linear-gradient(135deg,#10291c,#1a5033);
    color:white;
}

.frequency-display{
    text-align:center;
    padding:25px;
}

.frequency-number{
    font-size:50px;
    font-weight:900;
}

.frequency-unit{
    color:#a8cbb5;
}

.range{
    width:100%;
    accent-color:#9bd45c;
}

.frequency-info{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:20px;
}

.freq-box{
    background:rgba(255,255,255,.08);
    padding:13px;
    border-radius:11px;
}

.freq-box small{
    display:block;
    color:#a8cbb5;
    font-size:10px;
}

.freq-box strong{
    display:block;
    margin-top:4px;
}

.warning{
    margin-top:16px;
    background:#fff8e7;
    color:#795900;
    padding:13px;
    border-radius:10px;
    font-size:11px;
    line-height:1.5;
}

/* BENEFICIAL */
.insect-grid{
    grid-template-columns:repeat(3,1fr);
}

.insect-card{
    text-align:center;
}

.insect{
    font-size:55px;
    margin-bottom:12px;
}

.insect-card h3{
    font-size:15px;
}

.insect-card p{
    font-size:11px;
    color:var(--muted);
    line-height:1.6;
    margin-top:7px;
}

/* PROFILE */
.profile-card{
    max-width:650px;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    font-size:11px;
    font-weight:700;
    margin-bottom:6px;
}

.form-group input,
.form-group select{
    width:100%;
    padding:12px;
    border:1px solid var(--border);
    border-radius:10px;
}

/* TOAST */
.toast{
    position:fixed;
    bottom:25px;
    right:25px;
    background:#10291c;
    color:white;
    padding:14px 18px;
    border-radius:12px;
    box-shadow:0 15px 35px rgba(0,0,0,.2);
    transform:translateY(100px);
    opacity:0;
    transition:.3s;
    z-index:100;
    font-size:12px;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* MOBILE */
.mobile-menu{
    display:none;
}

@media(max-width:1000px){
    .stats{
        grid-template-columns:1fr;
    }
    .dashboard-main,
    .analytics-grid,
    .detect-layout{
        grid-template-columns:1fr;
    }
    .insect-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:760px){
    .sidebar{
        transform:translateX(-100%);
        transition:.25s;
    }
    .sidebar.open{
        transform:translateX(0);
    }
    .main{
        margin-left:0;
        width:100%;
    }
    .mobile-menu{
        display:block;
        width:39px;
        height:39px;
        border-radius:10px;
        background:#edf5ef;
        margin-right:10px;
    }
    .topbar{
        padding:0 15px;
    }
    .page-title{
        display:none;
    }
    .content{
        padding:20px 15px 35px;
    }
    .latest-body{
        grid-template-columns:1fr;
    }
    .pest-image{
        height:150px;
    }
    .form-grid{
        grid-template-columns:1fr;
    }
    .insect-grid{
        grid-template-columns:1fr;
    }
    .frequency-info{
        grid-template-columns:1fr;
    }
    .toolbar{
        flex-direction:column;
    }
    .profile span{
        display:none;
    }
    .realtime-advisory{
        padding:10px 15px;
        font-size:11px;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">

    <div class="logo">
