                        <div><strong>Tomato</strong><small style="display:block;color:var(--muted)">Aphids</small></div>
                    </div>

                    <div class="sample-item" onclick="loadSampleImage('assets/chilli_sample.jpg', 'Chilli Thrips (थ्रिप्स)', '92%', 'Medium', 'Chilli · Block 03', 22, 'Chilli')">
