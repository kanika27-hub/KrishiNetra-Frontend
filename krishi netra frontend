                id="uploadBox"
                ondragover="handleDragOver(event)"
                ondragleave="handleDragLeave(event)"
                ondrop="handleDrop(event)"
            >

                <div class="upload-icon" id="uploadIcon">📷</div>

                <h3>Upload or Capture Crop Leaf</h3>

                <p>
                    Take a clear photograph of infected leaves, stems, or pests across any crop.
                </p>

                <div style="display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:wrap;margin-top:16px;">
                    <label class="upload-btn" for="imageInput">
