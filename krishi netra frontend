                        </button>
                        <button type="button" class="secondary" style="padding:8px 14px;font-size:12px;" onclick="toggleCamera()">
                            Close Camera
                        </button>
                    </div>
                </div>

                <div class="preview" id="preview">
                    <img id="previewImage" alt="Selected crop image">
                </div>

            </div>

            <button
                id="detectButton"
                class="detect-btn"
                onclick="runDetection()"
                disabled
            >
                🔍 Analyze Image with KRISHI NETRA Vision
            </button>

            <!-- TEST ALL CROPS REAL SAMPLES BAR -->
            <div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px;">
                <span style="font-size:11px;font-weight:700;color:var(--muted);display:block;margin-bottom:8px;">
