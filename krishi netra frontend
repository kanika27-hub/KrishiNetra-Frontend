                        <div><strong>Rice</strong><small style="display:block;color:var(--muted)">Planthopper</small></div>
                    </div>

                    <div class="sample-item" onclick="loadSampleImage('assets/armyworm_sample.jpg', 'Fall Armyworm (सैनिक कीट)', '91%', 'High', 'Maize · Field 04', 32, 'Maize')">
                        <span class="ico">🌽</span>
                        <div><strong>Maize</strong><small style="display:block;color:var(--muted)">Armyworm</small></div>
                    </div>

                    <div class="sample-item" onclick="loadSampleImage('assets/ladybug_sample.jpg', 'Ladybird Beetle (मित्र कीट)', '98%', 'Beneficial', 'Tomato · Field 03', 0, 'Tomato')">
