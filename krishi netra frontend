                        <div><strong>Chilli</strong><small style="display:block;color:var(--muted)">Thrips</small></div>
                    </div>

                    <div class="sample-item" onclick="loadSampleImage('assets/cotton_sample.jpg', 'Whitefly (सफेद मक्खी)', '89%', 'High', 'Cotton · Field 01', 24, 'Cotton')">
